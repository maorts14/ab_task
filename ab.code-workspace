{
  "folders": [
    {
      "name": "ab",
      "path": "."
    },
    {
      "name": "sample_app",
      "path": "sample_app"
    }
  ],
  "settings": {
    "java.jdt.ls.vmargs": "-Xms256m -Xmx2G -XX:+UseG1GC -XX:+UseStringDeduplication"
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "java",
        "name": "Run Spring Environment Check API",
        "request": "launch",
        "mainClass": "com.example.springenvcheck.SpringEnvCheckApplication",
        "projectName": "spring-env-check"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Run Spring Environment Check API",
        "type": "shell",
        "command": "${workspaceFolder:sample_app}\\mvnw.cmd",
        "args": [
          "spring-boot:run"
        ],
        "options": {
          "cwd": "${workspaceFolder:sample_app}"
        },
        "problemMatcher": []
      }
    ]
  }
}
